{
  "compilerOptions": {
    "baseUrl": "src",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@app": ["app/App.jsx"],
      "@providers": ["providers/index.js"],
      "@hooks": ["hooks/index.js"],
      "@styles/*": ["styles/*"],
      "@ui/*": ["components/ui/*"],
      "@components/*": ["components/layout/*"],
      "@pages/*": ["pages/*"],
      "@images/*": ["assets/images/*"],
      "@feats/*": ["features/*"]
    }
  },
  "include": ["src/**/*", "main.jsx"],
  "exclude": ["node_modules"]
}
