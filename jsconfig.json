{
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["views/*"],
      "@shared/*": ["shared/components/*"],
      "@hooks": ["src/hooks/index.js"],
      "@pages/*": ["pages/*"],
      "@providers": ["src/providers/index.js"],
      "assets/*": ["shared/images/*"]
    }
  },
  "include": ["./"],
  "exclude": ["node_modules"]
}
